<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Filter Include="Source Files">
      <UniqueIdentifier>{$guid2$}</UniqueIdentifier>
      <Extensions>cpp;c;cxx;cc</Extensions>
    </Filter>
    <Filter Include="Header Files">
      <UniqueIdentifier>{$guid3$}</UniqueIdentifier>
      <Extensions>h;hh;hpp;hxx</Extensions>
    </Filter>
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="$projectname$.cpp">
      <Filter>Source Files</Filter>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="$projectname$.h">
      <Filter>Header Files</Filter>
    </ClInclude>
  </ItemGroup>
</Project>
